{
  "manifest_version": 3,
  "name": "Compra Casa — San Isidro",
  "version": "0.1.0",
  "description": "Guardá propiedades de ZonaProp, ArgenProp y MercadoLibre mientras navegás",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://www.zonaprop.com.ar/*",
    "https://www.argenprop.com/*",
    "https://*.mercadolibre.com.ar/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zonaprop.com.ar/propiedades/*"],
      "js": ["src/content/zonaprop.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.argenprop.com/*"],
      "js": ["src/content/argenprob.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.mercadolibre.com.ar/*"],
      "js": ["src/content/mercadolibre.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

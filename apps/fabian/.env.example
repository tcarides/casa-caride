# Cadena de conexión a Postgres (la inyecta Vercel al conectar la base Neon).
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Push notifications.
# Generá un par nuevo con:  npx web-push generate-vapid-keys
# Pegá la pública y la privada acá (y en las env vars de Vercel). NUNCA commitees
# las claves reales: este archivo es solo de ejemplo.
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"
VAPID_PUBLIC_KEY="<tu-clave-publica>"
VAPID_PRIVATE_KEY="<tu-clave-privada>"

# La clave pública también va en el cliente (Next.js la incluye en el bundle).
# Tiene que ser EXACTAMENTE la misma que VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<tu-clave-publica>"

# Protege el endpoint del cron: seteá este valor en Vercel y Vercel lo manda
# como Authorization: Bearer en cada ejecución programada.
CRON_SECRET="<un-secreto-random>"

# URLs de las zonas (mini-apps) que el shell reúne bajo un mismo origen.
# En desarrollo local podés dejarlas sin setear: el shell cae a localhost
# (super=3001, casas=3002, fabian=3003).
# En Vercel deben apuntar a la URL de cada proyecto desplegado.
SUPER_URL="https://casa-caride-super.vercel.app"
CASAS_URL="https://casa-caride-casas.vercel.app"

# Zona opcional: si falta, el build no rompe y la ruta /fabian no se cablea
# (el tile igual aparece en el launcher).
FABIAN_URL="https://casa-caride-fabian.vercel.app"

# Zona opcional Olivia (historia clínica): si falta, /olivia no se cablea.
OLIVIA_URL="https://casa-caride-olivia.vercel.app"

# ── Auth (Google login) ──
# Secret para firmar la sesión JWT (mismo valor en TODAS las zonas).
#   generar con: npx auth secret   (o openssl rand -base64 32)
AUTH_SECRET="genera-uno"
# OAuth de Google (Google Cloud Console → Credentials → OAuth client ID)
AUTH_GOOGLE_ID="xxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="xxxx"
# URL pública del shell (apex), para los callbacks de OAuth.
AUTH_URL="https://casa-caride.vercel.app"
# Base de datos del shell (Neon) para usuarios/permisos/invitaciones.
DATABASE_URL="postgres://..."

# Zona opcional Cuentas Claras (gastos compartidos): si falta, /cuentas-claras no se cablea.
CUENTAS_CLARAS_URL="https://casa-caride-cuentas-claras.vercel.app"

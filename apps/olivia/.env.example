# Cadena de conexión a Postgres (la inyecta Vercel al conectar la base Neon).
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Token de Vercel Blob para subir/borrar estudios (lo inyecta Vercel al crear
# el Blob store y conectarlo al proyecto). En local, copiá el valor desde Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

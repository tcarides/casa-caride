# Base de datos para el estado de usuario (favoritos, notas, descartados).
# El catálogo de propiedades vive en data/properties.json (no necesita DB).
#
# Si esta variable NO está, la app funciona en modo solo-lectura del JSON.
# Copiá este archivo a .env.local y pegá la cadena real (desde el proyecto
# original "casas" en Vercel -> Settings -> Environment Variables, o Neon).
POSTGRES_URL="postgresql://usuario:password@host/db?sslmode=require"
# Algunas integraciones usan también:
# DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

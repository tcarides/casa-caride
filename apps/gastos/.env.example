# ── Gastos de Casa (zona) ──

# Base de datos Neon propia de esta app (la inyecta Vercel al conectar la base).
# La app lee DATABASE_URL o POSTGRES_URL (cualquiera de las dos sirve).
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Secret para verificar la sesión JWT que emite el shell.
# TIENE que ser EXACTAMENTE el mismo valor que en el shell y las demás zonas.
AUTH_SECRET="el-mismo-de-las-otras-zonas"
